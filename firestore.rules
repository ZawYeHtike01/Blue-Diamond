
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Lunch Events
    match /lunchEvents/{eventId} {
      // Anyone can read lunch events.
      allow read: if true;

      // Only authenticated users can create, update, or delete.
      allow create, update, delete: if request.auth != null;
    }

    // News / Announcements
    match /news/{newsId} {
      // Anyone can read news without logging in.
      allow read: if true;

      // Authenticated users can create news documents
      // only under their own authenticated UID.
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.details is string
        && request.resource.data.author is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageFileId is string;

      // Users can update or delete only their own news.
      allow update, delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
